# HTTP
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://terminal:terminal@localhost:5432/terminal

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Quotes provider: mock | external | mt5
QUOTE_PROVIDER=mock
# Quote cache refresh interval in seconds (configurable, default 10)
QUOTE_REFRESH_SEC=10

# MT5 direct connection (used by server/services/mt5-api.js; optional)
MT5_SERVER_IP=
MT5_LOGIN=
MT5_PASSWORD=

# Auto sync between sites (Rusinvest <-> AlfaForex)
SYNC_ENABLED=false
# Main direction: rusinvest->alfaforex. Reverse is per sync_settings DB flag.
SYNC_DIRECTION=rusinvest_to_alfaforex
# Comma-separated peer base URLs: name=url pairs
SYNC_PEERS=rusinvest=https://rusinvest.example.com,alfaforex=https://alfaforex.example.com
# Shared secret for /api/sync/* endpoints
SYNC_API_KEY=change-me-sync-key

# Initial admin user (created by database/init.sql seed or on first run)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
