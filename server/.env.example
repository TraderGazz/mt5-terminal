# HTTP
PORT=4000

# PostgreSQL
# Портативная локальная БД (npm run db:start):  postgres://postgres@localhost:5432/terminal
# Docker (docker compose up -d):                postgres://terminal:terminal@localhost:5432/terminal
DATABASE_URL=postgres://postgres@localhost:5432/terminal

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# MT5-мост (SocketBridgeEA): mock — встроенный имитатор | real — живой EA (Этап 4)
MT5_BRIDGE=mock
MT5_BRIDGE_URL=http://mt5:8890/v1
MT5_BRIDGE_WS=ws://mt5:8890
MT5_SYMBOL=EURUSD

# --- устаревшее (ТЗ v2, до перехода на мост) ---
QUOTE_PROVIDER=mock
QUOTE_REFRESH_SEC=10
MT5_SERVER_IP=
MT5_LOGIN=
MT5_PASSWORD=

# Auto sync between sites (Rusinvest <-> AlfaForex)
SYNC_ENABLED=false
# Main direction: rusinvest->alfaforex. Reverse is per sync_settings DB flag.
SYNC_DIRECTION=rusinvest_to_alfaforex
# Comma-separated peer base URLs: name=url pairs
SYNC_PEERS=rusinvest=https://rusinvest.example.com,alfaforex=https://alfaforex.example.com
# Shared secret for /api/sync/* endpoints
SYNC_API_KEY=change-me-sync-key

# Initial admin user (created by database/init.sql seed or on first run)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
