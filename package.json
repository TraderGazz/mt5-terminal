{
  "name": "mt5-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Веб-терминал MT5 — мобильная PWA + ПК-версия. Монорепо.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build",
    "lint": "npm --workspace client run lint",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:psql": "node scripts/db.mjs psql",
    "db:init": "node scripts/db.mjs init",
    "db:reset": "node scripts/db.mjs reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
